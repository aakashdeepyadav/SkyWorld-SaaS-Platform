# ============================================
# SkyWorld Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.

# --- Server ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Optional: explicit backend public URL (used for local file URLs)
# BACKEND_URL=http://localhost:5000
# Render auto-sets this in production:
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skyworld?retryWrites=true&w=majority

# --- JWT Secrets ---
# Production: both should be >= 32 chars and must be different
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth 2.0 ---
# User sign-in / sign-up with Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Google Calendar / Google Meet integration for meeting creation
# These are the OAuth app credentials used by Admin Settings -> Google Integration.
# The actual meeting-creating Google account is whichever account the admin connects there.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/oauth/google/callback
# 32-byte key encoded as 64 hex characters; used to encrypt stored Google refresh tokens.
GOOGLE_OAUTH_ENCRYPTION_KEY=replace-with-64-char-hex-key
# Use "primary" for the connected account's default calendar, or set a specific calendar ID.
GOOGLE_CALENDAR_ID=primary

# --- Frontend URL (for CORS + reset links) ---
# Production must use HTTPS
FRONTEND_URL=http://localhost:5173
BRAND_WEBSITE_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Error Tracking (optional) ---
# Leave empty to disable Sentry integration
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# --- Razorpay ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Cloudinary (Image/File Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- Email Service (OTP + Password Reset) ---
# Brevo SMTP (recommended)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your_brevo_login
BREVO_SMTP_PASS=your_smtp_key

# Generic SMTP fallback (optional)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Email "from" identity
# IMPORTANT: this must be a sender/domain verified in Brevo
FROM_EMAIL=noreply@skyworld.com
FROM_NAME=SkyWorld Platform

# --- Meeting Confirmation Email (optional but recommended) ---
RESEND_API_KEY=your_resend_api_key
# If omitted, meeting confirmations fall back to FROM_EMAIL
FROM_RESEND_EMAIL=meetings@skyworld.com

# --- Google Sheets Logging (optional) ---
# Meeting bookings are appended to GOOGLE_SHEET_ID when configured.
GOOGLE_SHEET_ID=your_google_sheet_id

# You can provide either the full service-account JSON or just the PEM private key.
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com


# Optional dedicated analytics sheet; defaults to GOOGLE_SHEET_ID when omitted.
GOOGLE_ANALYTICS_SHEET_ID=your_google_analytics_sheet_id

# --- MailerSend (optional, admin document emails) ---
MAILERSEND_API_TOKEN=your_mailersend_api_token
MAILERSEND_FROM_EMAIL=docs@skyworld.com
MAILERSEND_FROM_NAME=SkyWorld Documents
MAILERSEND_MONTHLY_LIMIT=500

# Development only (if you want Ethereal instead)
# ETHEREAL_USER=your_ethereal_user@ethereal.email
# ETHEREAL_PASS=your_ethereal_password
