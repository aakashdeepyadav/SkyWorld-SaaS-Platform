# ============================================
# SkyWorld Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skyworld?retryWrites=true&w=majority

# --- JWT Secrets ---
# Generate strong random strings (e.g., openssl rand -hex 64)
# Production requirement: each secret should be at least 32 characters and both must be different
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth 2.0 ---
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Frontend URL (for CORS) ---
# Production requirement: must use HTTPS (e.g., https://www.skyworld.buzz)
FRONTEND_URL=http://localhost:5173

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Cloudinary (Image/File Storage) ──────────────────────────────────────────
# Free tier: 25 credits/month (~25GB storage + bandwidth)
# Sign up at https://cloudinary.com
# Get credentials from: Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional alternative (single var format)
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── Email Service (for Password Reset) ────────────────────────────────────────
# Production Setup (SendGrid - Recommended)
# Sign up at: https://signup.sendgrid.com
# Free tier: 100 emails/day forever
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# Alternative Production Options:
# AWS SES: https://aws.amazon.com/ses/
# Mailgun: https://www.mailgun.com/
# Postmark: https://postmarkapp.com/

# Email Settings
FROM_EMAIL=noreply@skyworld.com
FROM_NAME=SkyWorld Platform

# Development Only (Ethereal Email)
# Comment out production settings above and uncomment below
# ETHEREAL_USER=your_ethereal_user@ethereal.email
# ETHEREAL_PASS=your_ethereal_password

