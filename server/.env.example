# ============================================
# SkyWorld Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skyworld?retryWrites=true&w=majority

# --- JWT Secrets ---
# Production: both should be >= 32 chars and must be different
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Frontend URL (for CORS + reset links) ---
# Production must use HTTPS
FRONTEND_URL=http://localhost:5173

# --- Razorpay ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Cloudinary (Image/File Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- Email Service (OTP + Password Reset) ---
# Brevo SMTP (recommended)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your_brevo_login
BREVO_SMTP_PASS=your_smtp_key

# Generic SMTP fallback (optional)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Email "from" identity
# IMPORTANT: this must be a sender/domain verified in Brevo
FROM_EMAIL=noreply@skyworld.com
FROM_NAME=SkyWorld Platform

# Development only (if you want Ethereal instead)
# ETHEREAL_USER=your_ethereal_user@ethereal.email
# ETHEREAL_PASS=your_ethereal_password
