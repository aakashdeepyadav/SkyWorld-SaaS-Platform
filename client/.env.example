# ============================================
# SkyWorld Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Backend API URL ---
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (update with your Render URL):
# VITE_API_URL=https://skyworld-api.onrender.com/api

# --- Google OAuth 2.0 ---
# Must match the Client ID used on the backend
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
