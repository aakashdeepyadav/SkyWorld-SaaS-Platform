# ============================================
# SkyWorld Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Backend API URL ---
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (update with your Render URL):
# VITE_API_URL=https://skyworld-backend.onrender.com/api
# Do not set this to "/api" in production unless your host proxies POST/PUT/DELETE to backend.
VITE_WEBSITE_URL=https://skyworld.buzz

# --- Google OAuth 2.0 ---
# Must match the Client ID used on the backend
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Must match GOOGLE_REDIRECT_URI on the backend (prevents www/non-www mismatch)
VITE_GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
